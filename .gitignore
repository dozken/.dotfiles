.DS_Store

# TPM clones plugins into ~/.config/tmux/plugins (machine-local, kept out of repo)
tmux/.config/tmux/plugins/

raycast
fzf

# real secrets — only the .example template is tracked
.env.secrets

# never track credentials or machine-local profile data
.env
.env.*
!.env.secrets.example
*.pem
*.key
*.p12
.config/dotfiles/
